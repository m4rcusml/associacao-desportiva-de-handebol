{
  "name": "handebol-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26.8.2 <27",
    "npm": ">=12.2.0 <13"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "npm run build && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && prisma db seed",
    "presidente:inicial": "node --env-file-if-exists=.env dist/cli/presidente-inicial.js",
    "smoke:hospedado": "node scripts/smoke-hospedado.ts",
    "test:integration": "npm run build && node --env-file-if-exists=.env test/run-integration.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.18",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
