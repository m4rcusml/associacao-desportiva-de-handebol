PORT=3001
# Deve corresponder às credenciais e à porta do .env da raiz.
DATABASE_URL=postgresql://handebol:handebol_local@127.0.0.1:5432/handebol
TEST_DATABASE_URL=postgresql://handebol:handebol_local@127.0.0.1:5432/handebol_test
BETTER_AUTH_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:3000
# Gere localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Chave AES-256 (64 caracteres hex) da cópia cifrada da senha da arbitragem; gere com o mesmo comando.
ARBITRAGEM_SENHA_CHAVE=
# Fotos dos atletas (MAR-75): diretório local fora de produção. Para usar o Supabase Storage,
# defina as três variáveis SUPABASE_* juntas (bucket privado; chave secreta somente no backend).
FOTOS_DIRETORIO=.fotos-local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_FOTOS_BUCKET=
# Opcional (MAR-73): intervalo da varredura das notificações Socket.IO, em ms (padrão 30000).
# NOTIFICACOES_VARREDURA_MS=30000
