generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz
  accounts      AuthAccount[]
  sessions      AuthSession[]
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthSession {
  id        String   @id
  token     String   @unique
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  /// Versão de ativação do `Usuario` lida no login; o trigger da migração `sessao_conta_ativa` recusa versão desatualizada.
  versaoAtivacao Int?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
}

enum Perfil {
  atleta
  tecnico
  presidente
}

enum StatusVerificacao {
  pendente
  aprovado
  rejeitado
}

enum StatusCarteirinha {
  ativa
  invalidada
}

enum StatusCampeonato {
  planejado
  em_andamento
  encerrado
  cancelado
}

enum StatusJogo {
  agendado
  em_andamento
  finalizado
  cancelado
}

enum VisualizacaoArbitragem {
  linha
  banco
}

enum MetodoEntradaArbitragem {
  designacao
  senha
}

enum MotivoRevogacaoArbitragem {
  saida
  troca_senha
  jogo_encerrado
  jogo_adiado
  jogo_cancelado
}

enum TipoAlteracaoEscalacao {
  inclusao
  remocao
}

/// Alteração de credenciamento já feito (MAR-71): correção da camisa ou estorno.
enum TipoAlteracaoCredenciamento {
  correcao_camisa
  estorno
}

/// Tipos provisórios de lançamento (RF-037, RN-035, PEN-003): prefixo temp_ até confirmação do cliente.
enum TipoLancamento {
  temp_gol
  temp_cartaoAmarelo
  temp_exclusaoDoisMinutos
  temp_cartaoVermelho
}

enum TipoEventoCarteirinha {
  invalidacao
  reativacao
  substituicao_qr
}

model Usuario {
  id           String      @id @default(uuid()) @db.Uuid
  authId       String      @unique
  nomeCompleto String
  perfil       Perfil
  ativo        Boolean     @default(true)
  /// Incrementada a cada desativação/reativação; invalida logins iniciados antes da mudança.
  versaoAtivacao Int       @default(0)
  criadoEm     DateTime    @default(now()) @db.Timestamptz
  atleta       Atleta?
  tecnico      Tecnico?
  presidente   Presidente?
  arbitragens  Arbitragem[]
}

model Presidente {
  usuarioId             String         @id @db.Uuid
  usuario               Usuario        @relation(fields: [usuarioId], references: [id])
  criadoPorPresidenteId String?        @db.Uuid
  criadoPor             Presidente?    @relation("sucessao", fields: [criadoPorPresidenteId], references: [usuarioId])
  sucessores            Presidente[]   @relation("sucessao")
  clubes                Clube[]
  atletasVerificados    Atleta[]
  tecnicosVerificados   Tecnico[]
  vinculosDefinidos     VinculoClube[]
  carteirinhasEmitidas  Carteirinha[]
  eventosCarteirinha    EventoCarteirinha[]
  campeonatosCriados    Campeonato[]
  inscricoesIncluidas   InscricaoClube[]
  jogosCriados          Jogo[]
  arbitragensDesignadas Arbitragem[]
  suspensoesAplicadas   Suspensao[]    @relation("aplicadaPor")
  suspensoesRevogadas   Suspensao[]    @relation("revogadaPor")
}

model Atleta {
  usuarioId                 String            @id @db.Uuid
  usuario                   Usuario           @relation(fields: [usuarioId], references: [id])
  fotoChave                 String?
  statusVerificacao         StatusVerificacao @default(pendente)
  verificacaoSolicitadaEm   DateTime?         @db.Timestamptz
  verificadoPorPresidenteId String?           @db.Uuid
  verificadoPor             Presidente?       @relation(fields: [verificadoPorPresidenteId], references: [usuarioId])
  verificadoEm              DateTime?         @db.Timestamptz
  vinculos                  VinculoClube[]
  carteirinha               Carteirinha?
  participacoes             Participacao[]
  suspensoes                Suspensao[]
  alteracoesCredenciamento  AlteracaoCredenciamento[]
}

model Tecnico {
  usuarioId                 String            @id @db.Uuid
  usuario                   Usuario           @relation(fields: [usuarioId], references: [id])
  clubeId                   String?           @unique @db.Uuid
  clube                     Clube?            @relation(fields: [clubeId], references: [id])
  statusVerificacao         StatusVerificacao @default(pendente)
  verificacaoSolicitadaEm   DateTime?         @db.Timestamptz
  verificadoPorPresidenteId String?           @db.Uuid
  verificadoPor             Presidente?       @relation(fields: [verificadoPorPresidenteId], references: [usuarioId])
  verificadoEm              DateTime?         @db.Timestamptz
  escolhas                  Participacao[]
  alteracoesEscalacao       AlteracaoEscalacao[]
}

model Clube {
  id                    String         @id @default(uuid()) @db.Uuid
  nome                  String
  cidade                String?
  criadoPorPresidenteId String         @db.Uuid
  criadoPor             Presidente     @relation(fields: [criadoPorPresidenteId], references: [usuarioId])
  tecnico               Tecnico?
  vinculos              VinculoClube[]
  inscricoes            InscricaoClube[]
}

model VinculoClube {
  id                      String      @id @default(uuid()) @db.Uuid
  atletaId                String      @db.Uuid
  atleta                  Atleta      @relation(fields: [atletaId], references: [usuarioId])
  clubeId                 String      @db.Uuid
  clube                   Clube       @relation(fields: [clubeId], references: [id])
  inicio                  DateTime    @default(now()) @db.Timestamptz
  fim                     DateTime?   @db.Timestamptz
  definidoPorPresidenteId String?     @db.Uuid
  definidoPor             Presidente? @relation(fields: [definidoPorPresidenteId], references: [usuarioId])
  participacoes           Participacao[]
  alteracoesEscalacao     AlteracaoEscalacao[]
  alteracoesCredenciamento AlteracaoCredenciamento[]

  @@index([clubeId])
}

/// Identificação permanente do atleta (RN-011), emitida na mesma transação da aprovação (MAR-57).
/// Campos mínimos provisórios (PEN-008). Trigger diferido da migração `carteirinha` exige
/// atleta aprovado ⇔ carteirinha existente. Técnico não possui carteirinha (RN-012).
model Carteirinha {
  id                     String            @id @default(uuid()) @db.Uuid
  atletaId               String            @unique @db.Uuid
  atleta                 Atleta            @relation(fields: [atletaId], references: [usuarioId])
  /// Código opaco legível para conferência manual; não concede permissões.
  codigo                 String            @unique
  /// Token opaco aleatório lido do QR; identifica a carteirinha, nunca autoriza operações (RNF-004).
  tokenQr                String            @unique
  /// Versão do QR atual: começa em 1 e só avança de um em um a cada substituição (MAR-58).
  versaoQr               Int               @default(1)
  status                 StatusCarteirinha @default(ativa)
  emitidaEm              DateTime          @db.Timestamptz
  emitidaPorPresidenteId String            @db.Uuid
  emitidaPor             Presidente        @relation(fields: [emitidaPorPresidenteId], references: [usuarioId])
  eventos                EventoCarteirinha[]
  participacoes          Participacao[]
  alteracoesCredenciamento AlteracaoCredenciamento[]
}

/// Histórico somente de inclusão: invalidação, reativação e substituição do QR, com responsável e data (MAR-58).
model EventoCarteirinha {
  id            String                @id @default(uuid()) @db.Uuid
  carteirinhaId String                @db.Uuid
  carteirinha   Carteirinha           @relation(fields: [carteirinhaId], references: [id], onDelete: Cascade)
  tipo          TipoEventoCarteirinha
  /// Na substituição, versão do QR criada; nos demais eventos, versão vigente.
  versaoQr      Int
  presidenteId  String                @db.Uuid
  presidente    Presidente            @relation(fields: [presidenteId], references: [usuarioId])
  ocorridoEm    DateTime              @db.Timestamptz

  @@index([carteirinhaId, ocorridoEm])
}

/// Edição de campeonato com uma categoria textual (RF-013, RN-022), sem validação de idade/sexo.
/// Ciclo manual pelo presidente (MAR-61): planejado → em_andamento → encerrado, ou planejado/em_andamento
/// → cancelado. Datas são informativas. O trigger da migração `campeonatos` valida as transições e
/// suas pré-condições; encerrado e cancelado não mudam mais.
model Campeonato {
  id                    String           @id @default(uuid()) @db.Uuid
  nome                  String
  edicao                String
  categoria             String
  inicio                DateTime?        @db.Date
  fim                   DateTime?        @db.Date
  status                StatusCampeonato @default(planejado)
  criadoPorPresidenteId String           @db.Uuid
  criadoPor             Presidente       @relation(fields: [criadoPorPresidenteId], references: [usuarioId])
  inscricoes            InscricaoClube[]
  jogos                 Jogo[]
  suspensoes            Suspensao[]
}

/// Inclusão de clube no campeonato pelo presidente (RF-014, provisório: PEN-005). Única por
/// campeonato/clube; incluída ou retirada somente com o campeonato planejado e retirada somente
/// sem jogos (FK de `Jogo`). Imutável após a inclusão.
model InscricaoClube {
  id                      String     @id @default(uuid()) @db.Uuid
  campeonatoId            String     @db.Uuid
  campeonato              Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  clubeId                 String     @db.Uuid
  clube                   Clube      @relation(fields: [clubeId], references: [id])
  incluidaPorPresidenteId String     @db.Uuid
  incluidaPor             Presidente @relation(fields: [incluidaPorPresidenteId], references: [usuarioId])
  incluidaEm              DateTime   @default(now()) @db.Timestamptz
  jogosComoA              Jogo[]     @relation("inscricaoA")
  jogosComoB              Jogo[]     @relation("inscricaoB")
  participacoes           Participacao[]
  alteracoesCredenciamento AlteracaoCredenciamento[]

  @@unique([campeonatoId, clubeId])
  /// Alvo das FKs compostas de `Jogo`: garante as duas inscrições no mesmo campeonato do jogo.
  @@unique([id, campeonatoId])
  @@index([clubeId])
}

/// Jogo agendado pelo presidente (MAR-62) entre inscrições distintas do próprio campeonato (RN-022).
/// `inicioPrevistoEm` é o instante (UTC) e `fusoHorario` o nome IANA do local, validado pelo trigger da
/// migração `jogos_arbitragem`; o dia do jogo é calculado nesse fuso, nunca no do navegador.
/// Agendar não inicia o jogo. Ciclo (MAR-69): a arbitragem grava `iniciadoEm` (em andamento) e `encerradoEm`
/// (finalizado); o presidente adia (nova data, mesmo status) ou cancela. Transições validadas pelo trigger da migração `ciclo_jogo`.
model Jogo {
  id                    String         @id @default(uuid()) @db.Uuid
  campeonatoId          String         @db.Uuid
  campeonato            Campeonato     @relation(fields: [campeonatoId], references: [id])
  inscricaoClubeAId     String         @db.Uuid
  inscricaoClubeA       InscricaoClube @relation("inscricaoA", fields: [inscricaoClubeAId, campeonatoId], references: [id, campeonatoId], onDelete: Restrict, onUpdate: Restrict)
  inscricaoClubeBId     String         @db.Uuid
  inscricaoClubeB       InscricaoClube @relation("inscricaoB", fields: [inscricaoClubeBId, campeonatoId], references: [id, campeonatoId], onDelete: Restrict, onUpdate: Restrict)
  fusoHorario           String
  local                 String?
  inicioPrevistoEm      DateTime?      @db.Timestamptz
  iniciadoEm            DateTime?      @db.Timestamptz
  encerradoEm           DateTime?      @db.Timestamptz
  status                StatusJogo     @default(agendado)
  criadoPorPresidenteId String         @db.Uuid
  criadoPor             Presidente     @relation(fields: [criadoPorPresidenteId], references: [usuarioId])
  arbitragens           Arbitragem[]
  acessoArbitragem      AcessoArbitragem?
  participacoes         Participacao[]
  alteracoesEscalacao   AlteracaoEscalacao[]
  cumprimentosSuspensao CumprimentoSuspensao[]
  lancamentos           LancamentoJogo[]
  alteracoesCredenciamento AlteracaoCredenciamento[]

  @@index([campeonatoId, status])
  @@index([inscricaoClubeAId, campeonatoId])
  @@index([inscricaoClubeBId, campeonatoId])
}

/// Arbitragem do jogo (RF-024, RN-024): atribuição na partida, não perfil. Designada pelo presidente
/// (MAR-62) por conta de atleta/técnico (`usuarioId`, nome lido de `Usuario`) ou externa (`nomeCompleto`).
/// Designação não é sessão: acesso, senha e `SessaoArbitragem` vêm na MAR-65, que revalida o impedimento
/// de clube (RN-025). Triggers da migração `jogos_arbitragem` limitam mudanças ao jogo agendado/em andamento.
model Arbitragem {
  id                       String      @id @default(uuid()) @db.Uuid
  jogoId                   String      @db.Uuid
  jogo                     Jogo        @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  usuarioId                String?     @db.Uuid
  usuario                  Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nomeCompleto             String?
  designadoPorPresidenteId String?     @db.Uuid
  designadoPor             Presidente? @relation(fields: [designadoPorPresidenteId], references: [usuarioId], onDelete: Restrict)
  designadoEm              DateTime?   @db.Timestamptz
  /// Tela escolhida (RF-028/RN-029): muda só a apresentação, nunca as permissões.
  visualizacao             VisualizacaoArbitragem?
  /// Primeira entrada aceita para esta arbitragem (MAR-65).
  acessouEm                DateTime?   @db.Timestamptz
  sessoes                  SessaoArbitragem[]

  @@unique([jogoId, usuarioId])
  @@index([jogoId])
}

/// Participação do atleta no jogo (RF-016 a RF-023, RN-014/019/020): escolha preliminar do técnico,
/// credenciamento e entrada em quadra são etapas separadas no mesmo registro, sem criar equipe.
/// Aponta para o vínculo e a inscrição da época: transferência posterior não reescreve o registro.
/// MAR-64 grava a escolha (`escolhidaPorTecnicoId`/`escolhidaEm`, autoria da escolha vigente); a MAR-67, o
/// credenciamento pela arbitragem (carteirinha, data e camisa juntos, definitivos até a MAR-71) e a entrada em quadra
/// (uma vez, com o jogo em andamento). Triggers das migrações `escalacao` e `credenciamento` repetem as regras.
model Participacao {
  id                    String         @id @default(uuid()) @db.Uuid
  jogoId                String         @db.Uuid
  jogo                  Jogo           @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  /// Clube do atleta no jogo: inscrição de um dos dois clubes, do mesmo clube do vínculo.
  inscricaoClubeId      String         @db.Uuid
  inscricaoClube        InscricaoClube @relation(fields: [inscricaoClubeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vinculoClubeId        String         @db.Uuid
  vinculoClube          VinculoClube   @relation(fields: [vinculoClubeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Cópia do atleta do vínculo (conferida pelo trigger) para a unicidade de credenciamento por jogo.
  atletaId              String         @db.Uuid
  atleta                Atleta         @relation(fields: [atletaId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  escolhidaPorTecnicoId String?        @db.Uuid
  escolhidaPorTecnico   Tecnico?       @relation(fields: [escolhidaPorTecnicoId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  escolhidaEm           DateTime?      @db.Timestamptz
  carteirinhaId         String?        @db.Uuid
  carteirinha           Carteirinha?   @relation(fields: [carteirinhaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credenciadoEm         DateTime?      @db.Timestamptz
  numeroCamisa          Int?
  entrouEmQuadraEm      DateTime?      @db.Timestamptz
  lancamentos           LancamentoJogo[]

  @@unique([jogoId, vinculoClubeId])
  @@unique([jogoId, inscricaoClubeId, numeroCamisa])
  @@index([vinculoClubeId])
  @@index([atletaId])
}

/// Histórico somente de inclusão das alterações da escalação (MAR-64): quem incluiu ou retirou cada
/// atleta e quando, preservando a autoria mesmo após a substituição do técnico ou a retirada da escolha.
model AlteracaoEscalacao {
  id             String                 @id @default(uuid()) @db.Uuid
  jogoId         String                 @db.Uuid
  jogo           Jogo                   @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  vinculoClubeId String                 @db.Uuid
  vinculoClube   VinculoClube           @relation(fields: [vinculoClubeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tipo           TipoAlteracaoEscalacao
  tecnicoId      String                 @db.Uuid
  tecnico        Tecnico                @relation(fields: [tecnicoId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  ocorridoEm     DateTime               @db.Timestamptz

  @@index([jogoId, ocorridoEm])
  @@index([vinculoClubeId])
}

/// Histórico somente de inclusão das correções de camisa e dos estornos de credenciamento (MAR-71; seção 11,
/// PEN-019 parcial). Guarda uma cópia do credenciamento alterado (inscrição, vínculo, atleta, carteirinha, data e
/// camisa anterior), sem referência à participação, que deixa de existir no estorno de atleta não escalado. Na
/// correção, `numeroCamisaNova` é a camisa gravada; no estorno, fica vazia. Sem autoria, como as anulações de
/// lançamentos (RN-030, PEN-007). O trigger de `Participacao` só aceita a alteração com este registro na mesma transação.
model AlteracaoCredenciamento {
  id                   String                      @id @default(uuid()) @db.Uuid
  jogoId               String                      @db.Uuid
  jogo                 Jogo                        @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  inscricaoClubeId     String                      @db.Uuid
  inscricaoClube       InscricaoClube              @relation(fields: [inscricaoClubeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vinculoClubeId       String                      @db.Uuid
  vinculoClube         VinculoClube                @relation(fields: [vinculoClubeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atletaId             String                      @db.Uuid
  atleta               Atleta                      @relation(fields: [atletaId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  carteirinhaId        String                      @db.Uuid
  carteirinha          Carteirinha                 @relation(fields: [carteirinhaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credenciadoEm        DateTime                    @db.Timestamptz
  tipo                 TipoAlteracaoCredenciamento
  numeroCamisaAnterior Int
  numeroCamisaNova     Int?
  registradaEm         DateTime                    @db.Timestamptz

  @@index([jogoId, registradaEm])
  @@index([atletaId])
  @@index([vinculoClubeId])
  @@index([inscricaoClubeId])
  @@index([carteirinhaId])
}

/// Senha compartilhada do jogo (RN-028, MAR-65): hash para verificar a entrada e cópia cifrada (AES-256-GCM,
/// chave fora do banco) para consulta pelo presidente e pelas contas designadas. Nunca em texto puro.
model AcessoArbitragem {
  jogoId       String    @id @db.Uuid
  jogo         Jogo      @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  senhaHash    String
  senhaCifrada String
  geradaEm     DateTime  @db.Timestamptz
  revogadoEm   DateTime? @db.Timestamptz
}

/// Sessão temporária de arbitragem (PEN-030), separada da sessão de conta. Só o hash do token é guardado.
/// `authSessionId` (sem FK, como `Usuario.authId`) é a sessão de conta de origem da entrada por designação.
model SessaoArbitragem {
  id              String                     @id @default(uuid()) @db.Uuid
  arbitragemId    String                     @db.Uuid
  arbitragem      Arbitragem                 @relation(fields: [arbitragemId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  authSessionId   String?
  metodoEntrada   MetodoEntradaArbitragem
  tokenHash       String                     @unique
  criadaEm        DateTime                   @db.Timestamptz
  expiraEm        DateTime                   @db.Timestamptz
  revogadaEm      DateTime?                  @db.Timestamptz
  motivoRevogacao MotivoRevogacaoArbitragem?

  @@index([arbitragemId])
}

/// Suspensão manual aplicada pelo presidente (RF-038, RN-037/038/043, MAR-66): impede o atleta somente no
/// campeonato, por quantidade de jogos. Saldo = `quantidadeJogos` − cumprimentos, nunca armazenado.
/// Revogar (`revogadaEm`/`revogadaPor`) e encerrar o saldo com o campeonato (`saldoEncerradoEm`) são registros
/// distintos e definitivos, que preservam a suspensão e seus cumprimentos. Origem automática, regra e jogo de
/// origem ficam para a MAR-79. Triggers da migração `suspensoes` tornam os dados da aplicação imutáveis.
model Suspensao {
  id                      String                 @id @default(uuid()) @db.Uuid
  atletaId                String                 @db.Uuid
  atleta                  Atleta                 @relation(fields: [atletaId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  campeonatoId            String                 @db.Uuid
  campeonato              Campeonato             @relation(fields: [campeonatoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  quantidadeJogos         Int
  motivo                  String
  aplicadaPorPresidenteId String                 @db.Uuid
  aplicadaPor             Presidente             @relation("aplicadaPor", fields: [aplicadaPorPresidenteId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  aplicadaEm              DateTime               @db.Timestamptz
  revogadaEm              DateTime?              @db.Timestamptz
  revogadaPorPresidenteId String?                @db.Uuid
  revogadaPor             Presidente?            @relation("revogadaPor", fields: [revogadaPorPresidenteId], references: [usuarioId], onDelete: Restrict, onUpdate: Restrict)
  /// Término do saldo restante ao encerrar ou cancelar o campeonato (PEN-010); não é cumprimento nem revogação.
  saldoEncerradoEm        DateTime?              @db.Timestamptz
  cumprimentos            CumprimentoSuspensao[]

  @@index([atletaId, campeonatoId])
  @@index([campeonatoId])
}

/// Jogo encerrado definitivamente que contou para uma suspensão (RF-041, RN-039). A chave composta impede
/// contar o mesmo jogo duas vezes; suspensões simultâneas recebem cada uma o seu registro (paralelo).
model CumprimentoSuspensao {
  suspensaoId  String    @db.Uuid
  suspensao    Suspensao @relation(fields: [suspensaoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  jogoId       String    @db.Uuid
  jogo         Jogo      @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  registradoEm DateTime  @db.Timestamptz

  @@id([suspensaoId, jogoId])
  @@index([jogoId])
}

/// Ocorrência esportiva registrada pela arbitragem (RF-031/032, RN-032/033, MAR-68): fonte do placar e do
/// desempenho, que são projeções (views `EstatisticasDoJogo` e `DesempenhoDoAtleta` da migração
/// `lancamentos`), nunca tabelas editáveis. O clube vem da participação, sem campo próprio. `operacaoId` é o
/// identificador enviado pelo cliente: o reenvio devolve o registro existente, sem duplicar. O lançamento
/// nunca é apagado (MAR-70): a anulação é lógica (`anuladoEm`) e a correção anula o original e cria o substituto
/// (`substituiLancamentoId`) na mesma transação; as projeções ignoram os anulados.
model LancamentoJogo {
  id             String         @id @default(uuid()) @db.Uuid
  operacaoId     String         @unique @db.Uuid
  jogoId         String         @db.Uuid
  jogo           Jogo           @relation(fields: [jogoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  /// Obrigatória para todos os tipos atuais (CHECK); ausente só em futura ocorrência geral do jogo.
  participacaoId String?        @db.Uuid
  participacao   Participacao?  @relation(fields: [participacaoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tipo           TipoLancamento
  /// Inteiro positivo, 1 por ocorrência (RF-037).
  valor          Int            @default(1)
  registradoEm   DateTime       @db.Timestamptz
  /// Lançamento anulado por esta correção (MAR-70); cada um é substituído no máximo uma vez.
  substituiLancamentoId String?         @unique @db.Uuid
  substitui             LancamentoJogo? @relation("CorrecaoLancamento", fields: [substituiLancamentoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  substituidoPor        LancamentoJogo? @relation("CorrecaoLancamento")
  /// Anulação lógica (MAR-70): data e operação que anulou (a do substituto, na correção). Sem autoria (RN-030, PEN-007).
  anuladoEm             DateTime?       @db.Timestamptz
  anulacaoOperacaoId    String?         @unique @db.Uuid

  @@index([jogoId, registradoEm])
  @@index([participacaoId])
}
