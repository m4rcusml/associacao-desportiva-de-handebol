      "html": "<button class=\"ds-danger\">Confirmar encerramento</button>",
      "css": ".ds-danger{font-family:\"IBM Plex Sans\",sans-serif;font-size:14px;font-weight:600;line-height:18px;min-height:50px;padding:12px 20px;border:1px solid #AB302B;border-radius:8px;background:#AB302B;color:#FFFFFF;cursor:pointer}.ds-danger:hover,.ds-danger:active{background:#AB302B}.ds-danger:focus-visible{outline:2px solid #285CA7;outline-offset:2px}.ds-danger:disabled{background:#DDE3DE;color:#67766F;border-color:#DDE3DE;cursor:default}"
    },
    {
      "name": "Busca de atleta",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Busca nas telas de apoio; não faz parte da operação principal e não executa consulta nesta demonstração.",
      "html": "<label class=\"ds-search-label\">Buscar atleta ou camisa<input class=\"ds-search\" placeholder=\"Nome ou número\" type=\"search\"></label>",
      "css": ".ds-search-label{display:grid;gap:10px;font:400 14px/18px \"IBM Plex Sans\",sans-serif;color:#182E29}.ds-search{height:50px;padding:0 14px;border:1px solid #D3DDD6;border-radius:10px;background:#FFFFFF;color:#182E29;font:400 16px/21px \"IBM Plex Sans\",sans-serif;min-width:0}.ds-search::placeholder{color:#566861}.ds-search:focus-visible{outline:2px solid #285CA7;outline-offset:2px}.ds-search:disabled{background:#DDE3DE;color:#67766F}"
    },
    {
      "name": "Destinos inferiores",
      "kind": "nav",
      "description": "Barra móvel de 56 px, com ações de 44 px; Opções fica apenas aqui no celular.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Arbitragem\"><button class=\"ds-tab\">Credenciar</button><button class=\"ds-tab\">Súmula</button><button class=\"ds-tab\">Opções</button></nav>",
      "css": ".ds-nav{display:flex;height:56px;align-items:center;background:#FFFFFF;padding:0 16px}.ds-tab{flex:1;min-width:0;height:44px;border:0;border-radius:8px;background:#FFFFFF;color:#182E29;font:600 14px/18px \"IBM Plex Sans\",sans-serif;cursor:pointer}.ds-tab:hover,.ds-tab:active{background:#E5F1E9}.ds-tab:focus-visible{outline:2px solid #285CA7;outline-offset:-2px}"
    },
    {
      "name": "Estado do jogo",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Texto explícito de estado em tinta verde clara.",
