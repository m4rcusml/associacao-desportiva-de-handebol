      "css": ".ds-status{display:inline-block;padding:6px;border-radius:5px;background:#E5F1E9;color:#174F42;font:400 12px/16px \"IBM Plex Sans\",sans-serif}"
    },
    {
      "name": "Último gol confirmado",
      "kind": "card",
      "description": "Retorno curto com anulação auditável direta antes de encerrar. Demonstração sem persistência.",
      "html": "<section class=\"ds-last\"><div><strong class=\"ds-last-title\">Gol salvo · 7 · Ana Monteiro</strong><p class=\"ds-last-detail\">Serra Azul · placar atualizado</p></div><button class=\"ds-undo\">Desfazer</button></section>",
      "css": ".ds-last{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px;background:#E5F1E9;color:#182E29;font-family:\"IBM Plex Sans\",sans-serif}.ds-last-title{font-size:14px;font-weight:600;line-height:18px}.ds-last-detail{margin:4px 0 0;color:#566861;font-size:12px;line-height:16px}.ds-undo{min-width:88px;height:44px;padding:0 12px;border:0;border-radius:8px;background:#FFFFFF;color:#182E29;font:600 14px/18px \"IBM Plex Sans\",sans-serif;cursor:pointer}.ds-undo:hover,.ds-undo:active{background:#FFFFFF}.ds-undo:focus-visible{outline:2px solid #285CA7;outline-offset:-2px}"
    },
    {
      "name": "Camisa com ação direta",
      "kind": "custom",
      "refersTo": "shirt-compact",
      "description": "Variante compacta do Clube A; a camisa do credenciado é o alvo de + Gol, sem indicar presença em quadra.",
      "html": "<button class=\"ds-shirt-button\" aria-label=\"Registrar gol de Ana Monteiro, camisa 7, Serra Azul\"><svg class=\"ds-jersey\" viewBox=\"0 0 54 44\" aria-hidden=\"true\"><path d=\"M17 3 8 7 2 19 10 23 12 18V41H42V18L44 23 52 19 46 7 37 3C34 8 20 8 17 3Z\" fill=\"#EDF2FC\" stroke=\"#285CA7\" stroke-width=\"1.5\"/><text x=\"27\" y=\"32\" text-anchor=\"middle\" fill=\"#285CA7\">7</text></svg><span class=\"ds-shirt-name\">A. Monteiro</span><span class=\"ds-shirt-action\">+ Gol</span></button>",
      "css": ".ds-shirt-button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;width:83.5px;height:80px;padding:4px 0;border:0;border-radius:8px;background:#FFFFFF;color:#285CA7;font-family:\"IBM Plex Sans\",sans-serif;cursor:pointer}.ds-jersey{display:block;width:40px;height:34px;font-size:26px;font-weight:600;line-height:34px}.ds-shirt-name{color:#182E29;font-size:12px;font-weight:500;line-height:16px}.ds-shirt-action{font-size:12px;font-weight:500;line-height:16px}.ds-shirt-button:hover,.ds-shirt-button:active{background:#EDF2FC}.ds-shirt-button:focus-visible{outline:2px solid #285CA7;outline-offset:-2px}.ds-shirt-button:disabled{background:#DDE3DE;color:#67766F;cursor:default}"
    },
    {
      "name": "Ficha de cadastro do presidente",
      "kind": "card",
      "refersTo": "work-panel",
      "description": "Dados fictícios e decisão no mesmo painel; exemplo visual sem aprovação ou emissão real.",
      "html": "<section class=\"ds-registration\"><header class=\"ds-registration-head\"><span class=\"ds-registration-avatar\" aria-hidden=\"true\">LC</span><div><h2 class=\"ds-registration-name\">Luísa Costa Almeida</h2><p class=\"ds-registration-role\">Atleta</p></div></header><p class=\"ds-registration-state\">Aguardando aprovação</p><dl class=\"ds-registration-data\"><dt>Clube informado</dt><dd>Clube Atlético Serra Azul</dd><dt>Conta</dt><dd>Ativa</dd></dl><p class=\"ds-registration-help\">A aprovação confirma o vínculo e emite a carteirinha.</p><button class=\"ds-registration-approve\">Aprovar e emitir carteirinha</button></section>",
      "css": ".ds-registration{padding:16px;border-radius:12px;background:#FFFFFF;color:#182E29;font-family:\"IBM Plex Sans\",sans-serif;max-width:358px}.ds-registration-head{display:flex;align-items:center;gap:12px}.ds-registration-avatar{display:grid;place-items:center;flex-shrink:0;width:52px;height:52px;border-radius:50%;background:#EDF2FC;color:#285CA7;font-size:24px;font-weight:600}.ds-registration-name{margin:0;font-size:18px;font-weight:600;line-height:24px}.ds-registration-role{margin:4px 0 0;color:#566861;font-size:14px;line-height:18px}.ds-registration-state{padding:6px;border-radius:5px;background:#FFF3D2;color:#805400;font-size:12px;line-height:16px}.ds-registration-data{display:grid;grid-template-columns:auto 1fr;gap:16px;font-size:14px;line-height:18px;margin:24px 0}.ds-registration-data dt{color:#566861}.ds-registration-data dd{margin:0;font-weight:500}.ds-registration-help{font-size:14px;line-height:18px;color:#566861}.ds-registration-approve{width:100%;min-height:50px;padding:12px;border:0;border-radius:8px;background:#174F42;color:#FFFFFF;font:600 14px/18px \"IBM Plex Sans\",sans-serif;cursor:pointer}.ds-registration-approve:hover,.ds-registration-approve:active{background:#103D33}.ds-registration-approve:focus-visible{outline:2px solid #285CA7;outline-offset:2px}.ds-registration-approve:disabled{background:#DDE3DE;color:#67766F;cursor:default}"
    },
    {
      "name": "Lista visual de clube",
      "kind": "custom",
