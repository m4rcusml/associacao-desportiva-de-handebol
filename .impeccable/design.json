      "html": "<button class=\"ds-secondary\">Credenciar</button>",
      "css": ".ds-secondary{font-family:\"IBM Plex Sans\",sans-serif;font-size:14px;font-weight:600;line-height:18px;min-height:50px;padding:12px 20px;border:1px solid #D3DDD6;border-radius:8px;background:#FFFFFF;color:#182E29;cursor:pointer}.ds-secondary:hover,.ds-secondary:active{background:#FFFFFF}.ds-secondary:focus-visible{outline:2px solid #285CA7;outline-offset:2px}.ds-secondary:disabled{background:#DDE3DE;color:#67766F;border-color:#DDE3DE;cursor:default}"
    },
    {
